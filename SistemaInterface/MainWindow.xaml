<Window x:Class="SistemaInterface.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lista de Produtos" Height="450" Width="800">

    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Novo Produto:" FontWeight="Bold" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="txtNome" Width="180" Margin="0,0,5,0" Tag="Nome"/>
                <TextBox x:Name="txtPreco" Width="110" Margin="0,0,5,0" Tag="Preço"/>
                <Button Content="Adicionar" Click="btnAdicionar_Click" Width="90" Height="30"/>
                <Button x:Name="btnRelatorio" Content="Gerar Relatório" Click="btnRelatorio_Click" Width="90" Height="30" Margin="5" Background="LightBlue"/>
                <Button Content="Ver Histórico" Click="btnVerHistorico_Click" Width="90" Height="30" Margin="5" Background="LightGray"/>
            </StackPanel>
            <Separator Margin="0,10"/>
            <Button Content="Atualizar Lista" Click="btnAtualizar_Click" Height="30"/>
        </StackPanel>

        <Button DockPanel.Dock="Bottom" Content="Excluir Selecionado" 
            Click="btnExcluir_Click" Background="Salmon" Margin="0,10,0,0" Height="30"/>

        <DataGrid x:Name="dgProdutos" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                <DataGridTextColumn Header="Preço" Binding="{Binding Preco, StringFormat=C2}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>